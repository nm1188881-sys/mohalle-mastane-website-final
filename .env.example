# Copy to .env.local for local development, and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
# Use the Supabase publishable key (or legacy anon public key).
# Both values are public — never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
